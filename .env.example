# ------------------------------------------------------------------
# PROJECT
# ------------------------------------------------------------------

COMPOSE_PROJECT_NAME=lakehouse

# ------------------------------------------------------------------
# MINIO
# ------------------------------------------------------------------
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# ------------------------------------------------------------------
# NETWORKS
# ------------------------------------------------------------------
NETWORK_SPARK_DEV=spark_dev
NETWORK_CATALOG=catalog_net
NETWORK_STORAGE=storage_net
NETWORK_DATABASE=database_net

# ------------------------------------------------------------------
# MARIADB
# ------------------------------------------------------------------
MARIADB_IMAGE=mariadb:11.4
MARIADB_ROOT_PASSWORD=
MARIADB_PORT=3307

# ------------------------------------------------------------------
# POSTGRES
# ------------------------------------------------------------------
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=polaris
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# ============================================================
# HIVE
# ============================================================
HIVE_IMAGE=lakehouse-hive:4.0.0
HIVE_ICEBERG_PORT=9083
HIVE_DELTA_PORT=9084
HIVE_ICEBERG_DB_NAME=metastore_iceberg
HIVE_ICEBERG_DB_USER=
HIVE_ICEBERG_DB_PASSWORD=
HIVE_DELTA_DB_NAME=metastore_delta
HIVE_DELTA_DB_USER=
HIVE_DELTA_DB_PASSWORD=

# ============================================================
# POLARIS
# ============================================================
POLARIS_IMAGE=apache/polaris:1.7.0
POLARIS_ADMIN_IMAGE=apache/polaris-admin-tool:1.7.0
POLARIS_PORT=8181
POLARIS_MANAGEMENT_PORT=8182
POLARIS_REALM=POLARIS
POLARIS_CLIENT_ID=
POLARIS_CLIENT_SECRET=
POLARIS_CLIENT_INSURANCE_ID_OAUTH2=
POLARIS_CLIENT_INSURANCE_SECRET_OAUTH2=
POLARIS_CLIENT_RETAIL_ID_OAUTH2=
POLARIS_CLIENT_RETAIL_SECRET_OAUTH2=

# ============================================================
# POLARIS → MINIO
# ============================================================

POLARIS_S3_ENDPOINT=http://minio:9000
POLARIS_S3_REGION=us-east-1
POLARIS_S3_BUCKET=polaris

# ============================================================
# SPARK
# ============================================================
SPARK_IMAGE=lakehouse-spark:4.1.3
PY4J_VERSION=0.10.9.9

# ============================================================
# TRINO
# ============================================================
TRINO_IMAGE=trinodb/trino:483
TRINO_PORT=8080
POLARIS_INSURANCE_TRINO_CREDENTIAL=${POLARIS_CLIENT_INSURANCE_ID_OAUTH2}:${POLARIS_CLIENT_INSURANCE_SECRET_OAUTH2}
POLARIS_RETAIL_TRINO_CREDENTIAL=${POLARIS_CLIENT_RETAIL_ID_OAUTH2}:${POLARIS_CLIENT_RETAIL_SECRET_OAUTH2}
